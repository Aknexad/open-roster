import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";
import { AppHeaderEn } from "./app-header.slint";
import { NavigationMenuEn } from "./navigation.slint";
import { Footer } from "./footer.slint";

export component LeftSidBar inherits Rectangle {
    width: 240px;
    background: Theme.surface-color;
    border-color: Theme.border-color;
    border-width: 1px;

    // Accept navigate callback from parent
    callback navigate(string);

    VerticalBox {
        spacing: Theme.spacingMd;
        padding: Theme.spacingMd;

        // App Header
        AppHeaderEn { }

        // Navigation Links - forward navigate callback
        NavigationMenuEn {
            navigate(view) => { root.navigate(view); }
        }

        // Footer
        Footer { }
    }
}
