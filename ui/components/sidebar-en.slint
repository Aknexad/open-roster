import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";
import { ThemeToggle } from "./theme_toggle.slint";

export component LeftSidBar inherits Rectangle {
    width: 240px;
    background: Theme.surface-color;
    border-color: Theme.border-color;
    border-width: 1px;

    VerticalBox {
        spacing: Theme.spacingMd;
        padding: Theme.spacingMd;

        // App Header

        VerticalBox {
            Rectangle {
                background: transparent;

                HorizontalBox {
                    spacing: Theme.spacingSm;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        background: Theme.accent-color;
                        border-radius: Theme.radiusMd;

                        Text {
                            text: "OM";
                            color: Theme.surface-color;
                            font-size: 14px;
                            font-weight: Theme.weightBold;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalBox {
                        spacing: 2px;

                        Text {
                            text: "OpenMember";
                            color: Theme.text-primary-color;
                            font-size: Theme.fontXl;
                            font-weight: Theme.weightSemibold;
                        }

                        Text {
                            text: "Membership Management";
                            color: Theme.text-muted-color;
                            font-size: Theme.fontXs;
                        }
                    }
                }
        }
        }


        // Navigation Links
        VerticalBox {
                   Rectangle {
            background: Theme.accent-color;
            border-radius: Theme.radiusMd;
            height: Theme.heightLg;

            HorizontalBox {
                spacing: Theme.spacingMd;
                padding-left: Theme.spacingLg;
                padding-right: Theme.spacingLg;

                Image {
                    source: @image-url("../../assets/icons/kanban.svg");
                    vertical-alignment: center;
                    image-fit: contain;
                    width: Theme.iconLg;
                }

                Text {
                    text: "Dashboard";
                    color: Theme.surface-color;
                    font-size: Theme.fontMd;
                    font-weight: Theme.weightMedium;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: Theme.heightLg;
            padding-left: Theme.spacingLg;
            padding-right: Theme.spacingLg;
            border-radius: Theme.radiusMd;

            HorizontalBox {
                spacing: Theme.spacingMd;

                Image {
                    source: @image-url("../../assets/icons/user-group.svg");
                    vertical-alignment: center;
                    image-fit: contain;
                    width: Theme.iconLg;
                }

                Text {
                    text: "Members";
                    color: Theme.text-muted-color;
                    font-size: Theme.fontMd;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: Theme.heightLg;
            padding-left: Theme.spacingLg;
            padding-right: Theme.spacingLg;
            border-radius: Theme.radiusMd;

            HorizontalBox {
                spacing: Theme.spacingMd;

                Image {
                    source: @image-url("../../assets/icons/credit-card.svg");
                    vertical-alignment: center;
                    image-fit: contain;
                    width: Theme.iconLg;
                }

                Text {
                    text: "Plans";
                    color: Theme.text-muted-color;
                    font-size: Theme.fontMd;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: Theme.heightLg;
            padding-left: Theme.spacingLg;
            padding-right: Theme.spacingLg;
            border-radius: Theme.radiusMd;

            HorizontalBox {
                spacing: Theme.spacingMd;

                Image {
                    source: @image-url("../../assets/icons/cog.svg");
                    vertical-alignment: center;
                    image-fit: contain;
                    width: Theme.iconLg;
                }

                Text {
                    text: "Settings";
                    color: Theme.text-muted-color;
                    font-size: Theme.fontMd;
                    vertical-alignment: center;
                }
            }
        } 
        }


        VerticalBox {
                // Footer

        padding-top:400px;        
        Rectangle {
            background: transparent;
            height: Theme.heightLg;
            border-color: Theme.border-color;
            border-width: 1px;
            padding-left: Theme.spacingLg;
            padding-right: Theme.spacingLg;

            HorizontalBox {
                spacing: Theme.spacingMd;

                Image {
                    source: @image-url("../../assets/icons/circle-check-big.svg");
                    vertical-alignment: center;
                    image-fit: contain;
                    width: Theme.iconLg;
                }

                Text {
                    text: "v0.0.1";
                    color: Theme.text-muted-color;
                    font-size: Theme.fontLg;
                    vertical-alignment: center;
                }

                Rectangle { } // spacer

                ThemeToggle { }
            }
        }
        }
    }
}
