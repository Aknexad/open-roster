import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";
import { ThemeToggle } from "./theme_toggle.slint";

export component LeftSidBar inherits Rectangle {
    width: 240px;
    background: Theme.surfaceBg;
    border-color: Theme.borderColor;
    border-width: 1px;

    VerticalBox {
        spacing: Theme.spacingMd;
        padding: Theme.spacingMd;

        // App Header
        Rectangle {
            background: transparent;

            HorizontalBox {
                spacing: Theme.spacingSm;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: Theme.primary;
                    border-radius: Theme.radiusMd;

                    Text {
                        text: "OM";
                        color: #FFFFFF;
                        font-size: 14px;
                        font-weight: Theme.weightBold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalBox {
                    spacing: 2px;

                    Text {
                        text: "OpenMember";
                        color: Theme.neutral800;
                        font-size: Theme.fontXl;
                        font-weight: Theme.weightSemibold;
                    }

                    Text {
                        text: "Membership Management";
                        color: Theme.neutral500;
                        font-size: Theme.fontXs;
                    }
                }
            }
        }

        // Navigation Links
        Rectangle {
            background: Theme.primaryLight;
            border-radius: Theme.radiusMd;
            height: 55px;

            HorizontalBox {
                spacing: Theme.spacingMd;
                padding-left: 12px;
                padding-right: 12px;

                Image {
                    source: @image-url("../../assets/icons/kanban.svg");
                    vertical-alignment: center;
                    image-fit: contain;
                    width: 25px;
                }

                Text {
                    text: "Dashboard";
                    color: Theme.primary;
                    font-size: Theme.fontMd;
                    font-weight: Theme.weightMedium;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 55px;
            padding-left: 12px;
            padding-right: 12px;

            HorizontalBox {
                spacing: Theme.spacingMd;

                Image {
                    source: @image-url("../../assets/icons/user-group.svg");
                    vertical-alignment: center;
                    image-fit: contain;
                    width: 25px;
                }

                Text {
                    text: "Members";
                    color: Theme.neutral500;
                    font-size: Theme.fontMd;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 55px;
            padding-left: 12px;
            padding-right: 12px;

            HorizontalBox {
                spacing: Theme.spacingMd;

                Image {
                    source: @image-url("../../assets/icons/credit-card.svg");
                    vertical-alignment: center;
                    image-fit: contain;
                    width: 25px;
                }

                Text {
                    text: "Plans";
                    color: Theme.neutral500;
                    font-size: Theme.fontMd;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 55px;
            padding-left: 12px;
            padding-right: 12px;

            HorizontalBox {
                spacing: Theme.spacingMd;

                Image {
                    source: @image-url("../../assets/icons/cog.svg");
                    vertical-alignment: center;
                    image-fit: contain;
                    width: 25px;
                }

                Text {
                    text: "Settings";
                    color: Theme.neutral500;
                    font-size: Theme.fontMd;
                    vertical-alignment: center;
                }
            }
        }

        // Footer
        Rectangle {
            background: transparent;
            height: 50px;
            border-color: Theme.borderColor;
            border-width: 1px;
            padding-left: 12px;
            padding-right: 12px;

            HorizontalBox {
                spacing: Theme.spacingMd;

                Image {
                    source: @image-url("../../assets/icons/circle-check-big.svg");
                    vertical-alignment: center;
                    image-fit: contain;
                    width: 25px;
                }

                Text {
                    text: "v0.0.1";
                    color: Theme.neutral500;
                    font-size: Theme.fontLg;
                    vertical-alignment: center;
                }

                Rectangle { } // spacer

                ThemeToggle { }
            }
        }
    }
}
