import { HorizontalBox } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";

export component Button inherits Rectangle {
    in-out property <string> text: "Button";
    in-out property <color> bg-color: Theme.accent-color;
    in-out property <color> text-color: Theme.surface-color;
    in property <string> variant: "primary"; // "primary" | "secondary" | "ghost" | "destructive"
    height: Theme.heightMd;
    background: root.bg-color;
    border-radius: Theme.radiusMd;
    padding-left: Theme.spacingLg;
    padding-right: Theme.spacingLg;
    min-width: 80px;

    HorizontalBox {
        spacing: Theme.spacingXs;

        Text {
            text: root.text;
            color: root.text-color;
            font-size: Theme.fontMd;
            font-weight: Theme.weightMedium;
            vertical-alignment: center;
        }
    }

    // Hover state
    animate background {
        duration: 120ms;
        easing: ease-out;
    }
}
