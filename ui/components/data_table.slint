import {
    VerticalBox,
    HorizontalBox,
    StandardListView,
} from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";

export component DataTableColumn inherits Rectangle {
    in-out property <string> label: "";
    preferred-width: 100px;
    height: 40px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    background: Theme.neutral50;
    border-color: Theme.borderColor;
    border-width: 1px;

    Text {
        text: root.label;
        color: Theme.neutral500;
        font-size: Theme.fontXs;
        font-weight: Theme.weightSemibold;
    }
}

export component DataTableRow inherits Rectangle {
    in-out property <string> name: "";
    in-out property <string> phone: "";
    in-out property <string> plan: "";
    in-out property <string> expiry: "";
    in-out property <string> status: "";
    in-out property <color> status-color: Theme.success;
    in-out property <string> action-text: "Renew";
    in-out property <color> action-color: Theme.primary;
    in-out property <string> initials: "U";

    height: 48px;
    width: 100%;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-color: Theme.neutral100;
    border-width: 1px;

    HorizontalBox {
        spacing: Theme.spacingSm;

        Rectangle {
            width: 32px;
            height: 32px;
            background: Theme.primaryLight;
            border-radius: 16px;

            Text {
                text: root.initials;
                color: Theme.primary;
                font-size: Theme.fontXs;
                font-weight: Theme.weightSemibold;
                horizontal-alignment: center;
            }
        }

        Text {
            text: root.name;
            color: Theme.neutral800;
            font-size: Theme.fontMd;
            font-weight: Theme.weightMedium;
            width: 200px;
        }

        Text {
            text: root.phone;
            color: Theme.neutral800;
            font-size: Theme.fontMd;
            width: 160px;
        }

        Text {
            text: root.plan;
            color: Theme.neutral800;
            font-size: Theme.fontMd;
            width: 140px;
        }

        Text {
            text: root.expiry;
            color: Theme.neutral800;
            font-size: Theme.fontMd;
            width: 160px;
        }

        Text {
            text: root.status;
            color: root.status-color;
            font-size: Theme.fontXs;
            font-weight: Theme.weightMedium;
            width: 140px;
        }

        Text {
            text: root.action-text;
            color: root.action-color;
            font-size: Theme.fontMd;
            font-weight: Theme.weightMedium;
            width: 80px;
        }
    }
}
