import {
    VerticalBox,
    HorizontalBox,
    StandardListView,
} from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";

export component DataTableColumn inherits Rectangle {
    in-out property <string> label: "";
    preferred-width: 100px;
    height: Theme.heightMd;
    padding-left: Theme.spacingMd;
    padding-right: Theme.spacingMd;
    padding-top: Theme.spacingSm;
    padding-bottom: Theme.spacingSm;
    background: Theme.surface-secondary-color;
    border-color: Theme.border-color;
    border-width: 1px;

    Text {
        text: root.label;
        color: Theme.text-secondary-color;
        font-size: Theme.fontXs;
        font-weight: Theme.weightSemibold;
    }
}

export component DataTableRow inherits Rectangle {
    in-out property <string> name: "";
    in-out property <string> phone: "";
    in-out property <string> plan: "";
    in-out property <string> expiry: "";
    in-out property <string> status: "";
    in-out property <color> status-color: Theme.success-color;
    in-out property <string> action-text: "Renew";
    in-out property <color> action-color: Theme.accent-color;
    in-out property <string> initials: "U";

    height: Theme.heightXl;
    width: 100%;
    padding-left: Theme.spacingLg;
    padding-right: Theme.spacingLg;
    padding-top: Theme.spacingSm;
    padding-bottom: Theme.spacingSm;
    border-color: Theme.border-color;
    border-width: 1px;
    background: Theme.surface-color;

    HorizontalBox {
        spacing: Theme.spacingSm;

        Rectangle {
            width: Theme.iconLg;
            height: Theme.iconLg;
            background: Theme.accent-color;
            border-radius: Theme.iconLg;

            Text {
                text: root.initials;
                color: Theme.surface-color;
                font-size: Theme.fontXs;
                font-weight: Theme.weightSemibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.name;
            color: Theme.text-primary-color;
            font-size: Theme.fontMd;
            font-weight: Theme.weightMedium;
            width: 200px;
        }

        Text {
            text: root.phone;
            color: Theme.text-primary-color;
            font-size: Theme.fontMd;
            width: 160px;
        }

        Text {
            text: root.plan;
            color: Theme.text-primary-color;
            font-size: Theme.fontMd;
            width: 140px;
        }

        Text {
            text: root.expiry;
            color: Theme.text-primary-color;
            font-size: Theme.fontMd;
            width: 160px;
        }

        Text {
            text: root.status;
            color: root.status-color;
            font-size: Theme.fontXs;
            font-weight: Theme.weightMedium;
            width: 140px;
        }

        Text {
            text: root.action-text;
            color: root.action-color;
            font-size: Theme.fontMd;
            font-weight: Theme.weightMedium;
            width: 80px;
        }
    }
}
