import {
    VerticalBox,
    HorizontalBox,
    StandardListView,
} from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";

export component Modal inherits Rectangle {
    in-out property <string> title: "Dialog";
    height: 320px;

    background: Theme.surface-color;
    border-color: Theme.border-color;
    border-width: 1px;
    border-radius: Theme.radiusLg;
    padding: Theme.spacingLg;

    VerticalBox {
        spacing: Theme.spacingMd;

        HorizontalBox {
            spacing: Theme.spacingSm;

            Text {
                text: root.title;
                color: Theme.text-primary-color;
                font-size: Theme.fontXl;
                font-weight: Theme.weightBold;
            }

            Rectangle { } // spacer
        }

        Rectangle {
            width: 100%;
            height: 1px;
            background: Theme.border-color;
        }

        Rectangle {
            width: 100%;
            height: 100%;
            // Content slot
        }

        HorizontalBox {
            spacing: Theme.spacingSm;

            Rectangle {
                height: Theme.heightSm;
                background: Theme.surface-secondary-color;
                border-color: Theme.border-color;
                border-width: 1px;
                border-radius: Theme.radiusMd;
                padding-left: Theme.spacingLg;
                padding-right: Theme.spacingLg;

                Text {
                    text: "Cancel";
                    color: Theme.text-secondary-color;
                    font-size: Theme.fontSm;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: Theme.heightSm;
                background: Theme.accent-color;
                border-radius: Theme.radiusMd;
                padding-left: Theme.spacingLg;
                padding-right: Theme.spacingLg;

                Text {
                    text: "Confirm";
                    color: Theme.surface-color;
                    font-size: Theme.fontSm;
                    font-weight: Theme.weightMedium;
                    vertical-alignment: center;
                }
            }
        }
    }
}
