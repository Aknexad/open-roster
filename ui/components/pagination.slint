import { HorizontalBox } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";

export component Pagination inherits Rectangle {
    in-out property <string> showing-text: "Showing";
    in-out property <string> range-text: "1 to 8";
    in-out property <string> total-text: "of 8 members";
    in-out property <int> current-page: 1;
    in-out property <int> total-pages: 1;

    height: 44px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 10px;
    padding-bottom: 10px;
    background: Theme.surfaceBg;
    border-color: Theme.borderColor;
    border-width: 1px;
    border-radius: Theme.radiusLg;

    HorizontalBox {
        spacing: Theme.spacingSm;

        Text {
            text: root.showing-text;
            color: Theme.neutral500;
            font-size: Theme.fontMd;
        }

        Text {
            text: root.range-text;
            color: Theme.neutral800;
            font-size: Theme.fontMd;
            font-weight: Theme.weightSemibold;
        }

        Text {
            text: root.total-text;
            color: Theme.neutral500;
            font-size: Theme.fontMd;
        }

        Rectangle { } // spacer

        Rectangle {
            height: 30px;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 4px;
            padding-bottom: 4px;
            background: Theme.neutral50;
            border-color: Theme.borderColor;
            border-width: 1px;
            border-radius: Theme.radiusSm;

            Text {
                text: "←";
                color: Theme.neutral500;
                font-size: Theme.fontXs;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 30px;
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 4px;
            padding-bottom: 4px;
            background: Theme.primary;
            border-radius: Theme.radiusSm;

            Text {
                text: "1";
                color: #FFFFFF;
                font-size: Theme.fontXs;
                font-weight: Theme.weightSemibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 30px;
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 4px;
            padding-bottom: 4px;
            background: Theme.neutral50;
            border-color: Theme.borderColor;
            border-width: 1px;
            border-radius: Theme.radiusSm;

            Text {
                text: "2";
                color: Theme.neutral500;
                font-size: Theme.fontXs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 30px;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 4px;
            padding-bottom: 4px;
            background: Theme.neutral50;
            border-color: Theme.borderColor;
            border-width: 1px;
            border-radius: Theme.radiusSm;

            Text {
                text: "→";
                color: Theme.neutral500;
                font-size: Theme.fontXs;
                vertical-alignment: center;
            }
        }
    }
}
