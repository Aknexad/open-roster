import { HorizontalBox } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";

export component Pagination inherits Rectangle {
    in-out property <string> showing-text: "Showing";
    in-out property <string> range-text: "1 to 8";
    in-out property <string> total-text: "of 8 members";
    in-out property <int> current-page: 1;
    in-out property <int> total-pages: 1;

    height: Theme.heightLg;
    padding-left: Theme.spacingLg;
    padding-right: Theme.spacingLg;
    padding-top: Theme.spacingSm;
    padding-bottom: Theme.spacingSm;
    background: Theme.surface-color;
    border-color: Theme.border-color;
    border-width: 1px;
    border-radius: Theme.radiusLg;

    HorizontalBox {
        spacing: Theme.spacingSm;

        Text {
            text: root.showing-text;
            color: Theme.text-muted-color;
            font-size: Theme.fontMd;
        }

        Text {
            text: root.range-text;
            color: Theme.text-primary-color;
            font-size: Theme.fontMd;
            font-weight: Theme.weightSemibold;
        }

        Text {
            text: root.total-text;
            color: Theme.text-muted-color;
            font-size: Theme.fontMd;
        }

        Rectangle { } // spacer

        Rectangle {
            height: Theme.heightSm;
            padding-left: Theme.spacingMd;
            padding-right: Theme.spacingMd;
            padding-top: Theme.spacingXs;
            padding-bottom: Theme.spacingXs;
            background: Theme.surface-secondary-color;
            border-color: Theme.border-color;
            border-width: 1px;
            border-radius: Theme.radiusSm;

            Text {
                text: "←";
                color: Theme.text-muted-color;
                font-size: Theme.fontXs;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: Theme.heightSm;
            padding-left: Theme.spacingMd;
            padding-right: Theme.spacingMd;
            padding-top: Theme.spacingXs;
            padding-bottom: Theme.spacingXs;
            background: Theme.accent-color;
            border-radius: Theme.radiusSm;

            Text {
                text: "1";
                color: Theme.surface-color;
                font-size: Theme.fontXs;
                font-weight: Theme.weightSemibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: Theme.heightSm;
            padding-left: Theme.spacingMd;
            padding-right: Theme.spacingMd;
            padding-top: Theme.spacingXs;
            padding-bottom: Theme.spacingXs;
            background: Theme.surface-secondary-color;
            border-color: Theme.border-color;
            border-width: 1px;
            border-radius: Theme.radiusSm;

            Text {
                text: "2";
                color: Theme.text-muted-color;
                font-size: Theme.fontXs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: Theme.heightSm;
            padding-left: Theme.spacingMd;
            padding-right: Theme.spacingMd;
            padding-top: Theme.spacingXs;
            padding-bottom: Theme.spacingXs;
            background: Theme.surface-secondary-color;
            border-color: Theme.border-color;
            border-width: 1px;
            border-radius: Theme.radiusSm;

            Text {
                text: "→";
                color: Theme.text-muted-color;
                font-size: Theme.fontXs;
                vertical-alignment: center;
            }
        }
    }
}
