import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { TopToolbar } from "./top_toolbar.slint";
import { DashboardView } from "../views/dashboard.slint";
import { MembersView } from "../views/members.slint";
import { PlansView } from "../views/plans.slint";
import { SettingsView } from "../views/settings.slint";
import { Theme } from "../styles/theme.slint";

export component MainWindow inherits VerticalBox {
    // ── Current view state ──
    in-out property <string> current-view: "dashboard";

    // ── Top Toolbar ──
    TopToolbar { }

    // ── View Slot (dynamically shown based on current-view) ──
    DashboardView {
        visible: current-view == "dashboard";
    }

    MembersView {
        visible: current-view == "members";
    }

    PlansView {
        visible: current-view == "plans";
    }

    SettingsView {
        visible: current-view == "settings";
    }
}
