import { VerticalBox, HorizontalBox, ComboBox } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";
import { Input } from "./input.slint";
import { Button } from "./button.slint";

export component TopToolbar inherits Rectangle {
    height: 75px;
    padding: Theme.spacingMd;
    background: Theme.surfaceBg;
    border-color: Theme.borderColor;
    border-width: 1px;

    HorizontalBox {
        spacing: Theme.spacingMd;

        Input {
            placeholder: "Search members...";
            preferred-width: 280px;
        }

        Button {
            text: "+ Add Member";
            bg-color: Theme.primary;
            preferred-width: 120px;
        }
    }
}
