import { VerticalBox, HorizontalBox, ComboBox } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";
import { Input } from "./input.slint";
import { Button } from "./button.slint";

export component TopToolbar inherits Rectangle {
    height: Theme.heightXXL;

    background: Theme.surface-color;
    border-color: Theme.border-color;
    border-width: 1px;

    HorizontalBox {
        spacing: Theme.spacingLg;

        Input {
            placeholder: "Search members...";
            width: 870px;
        }

        Button {
            text: "+ Add Member";
            bg-color: Theme.accent-color;
        }
    }
}
