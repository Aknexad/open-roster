import { HorizontalBox } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";

export component ThemeToggle inherits Rectangle {
    width: 48px;
    height: 26px;
    background: root.enabled ? (Theme.dark-mode ? Theme.accent-color : Theme.neutral300) : Theme.disabled-color;
    border-radius: 13px;

    property <bool> enabled: true;

    callback toggled();

    TouchArea {
        clicked => {
            Theme.dark-mode = Theme.dark-mode ? false : true;
            root.toggled();
        }
    }

    Rectangle {
        x: Theme.dark-mode ? parent.width - 22px : 2px;
        width: 22px;
        height: 22px;
        background: Theme.surface-color;
        border-radius: 11px;
        border-color: Theme.border-color;
        border-width: 1px;

        Text {
            text: Theme.dark-mode ? "🌙" : "☀️";
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }
}
